# Telegram Journal Companion Bot Configuration
# Copy this file to .env and fill in your values.

# Bot token obtained from @BotFather
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# Your numerical Telegram user ID for private DMs (e.g. 123456789)
TELEGRAM_CHAT_ID=""

# Your private Telegram journal channel ID (e.g. -1001234567890)
# The bot must be added as an Administrator in this channel for live ingestion.
TELEGRAM_CHANNEL_ID=""

# Optional default export directory (falls back to auto-discovery if omitted)
# DEFAULT_EXPORT_DIR="ChatExport_kieran's channel"

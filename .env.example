# Telegram Journal Companion Bot Configuration
# Copy this file to .env and fill in your values.

# Bot token obtained from @BotFather
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# Your numerical Telegram user ID or channel ID (e.g. 123456789 or -1001234567890)
# You can get your user ID by messaging @userinfobot or running scripts/get_chat_id.py
TELEGRAM_CHAT_ID=""

# Optional default export directory (falls back to auto-discovery if omitted)
# DEFAULT_EXPORT_DIR="ChatExport_kieran's channel"
